{
  "name": "empeo-registration-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright automation tests for the empeo free-trial registration flow (Gofive UAT)",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --workers=1",
    "test:smoke": "playwright test --grep @smoke",
    "test:video": "playwright test --config=playwright.video.config.js",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^18.0.8"
  }
}
